{
  "name": "agent-relay",
  "version": "2.0.0",
  "private": true,
  "description": "接力台：额度用完换谁接着做都不怕。多个 AI 在同一个项目文件夹里轮流接着做，弱模型做的由强模型复核，改坏了能退回；还能拉进群里讨论、投票。",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "relay": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/src/cli.js && cp -R src/web dist/src/web",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js ui"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
